worker/node_modules/
worker/.dev.vars
.DS_Store
*.xcuserstate
build/
releases/
.claude/
coding-plans/

# Xcode per-user state — don't commit
*.xcodeproj/xcuserdata/

# LLVM coverage output dropped next to the binary
default.profraw

# Local sandboxes the eval + profile scripts use
/tmp/pace-test-derived-data/
/tmp/pace-profile-*/
__pycache__/

# Blume documentation site (presentation layer — generated, not source of truth)
.blume/
.blume-verify/
node_modules/
dist/

# Local agent logs / scratch (never commit agent session artifacts)
.agent-logs/
.devin-scratch/

# SwiftPM build directory
.build/

# Orphaned dependency tree — personal-platform/ holds only node_modules and
# .wrangler with no source; safe to delete locally.
personal-platform/

# Next-step router data + student checkpoints (~1.7 GB, regenerable via
# scripts/generate-router-step-states.py → label-router-step-states.py → train-router-student.py).
# Coverage summaries stay tracked; run metrics are copied to evals/jev-experiment/students/.
evals/router-data/*
!evals/router-data/coverage.json
!evals/router-data/coverage-extra.json
