{
  "name": "pace-website",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "bash ../scripts/generate-og-image.sh || true && bash ../scripts/generate-release-info.sh || true",
    "build": "pnpm run build:docs && astro build",
    "build:docs": "node scripts/merge-blume-docs.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "pnpm run build && wrangler pages deploy dist --project-name pace"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.3.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "lightningcss": "^1.33.0",
    "wrangler": "^4.120.1"
  },
  "pnpm": {
    "overrides": {
      "sharp@<0.35.4": "0.35.4",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "svgo@>=4.0.0 <4.1.0": "4.1.0",
      "undici@>=7.0.0 <8.0.0": "7.29.1",
      "devalue@>=5.0.0 <6.0.0": "5.9.3",
      "http-cache-semantics": "4.3.0"
    },
    "patchedDependencies": {
      "http-cache-semantics@4.3.0": "../patches/http-cache-semantics@4.3.0.patch"
    }
  }
}
