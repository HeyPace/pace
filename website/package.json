{
  "name": "pace-website",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "bash ../scripts/generate-og-image.sh || true && bash ../scripts/generate-release-info.sh || true",
    "build": "pnpm run build:docs && astro build",
    "build:docs": "node scripts/merge-blume-docs.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "pnpm run build && wrangler pages deploy dist --project-name pace"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "lightningcss": "^1.33.0",
    "wrangler": "^4.120.1"
  }
}
