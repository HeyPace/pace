---
// Native links remain source-owned in the shared composition’s navigation slot.
---

<nav slot="navigation" data-fleet-footer-navigation aria-label="Pace navigation">
    <div
      class="pace-footer-navigation text-sm text-[var(--color-text-muted)]"
    >
      <div class="flex items-center gap-2 text-white">
        <span class="inline-flex items-end gap-[3px] h-5 w-6 text-[var(--color-accent)]" aria-hidden="true">
          <span class="pace-bar h-3"></span>
          <span class="pace-bar h-5"></span>
          <span class="pace-bar h-4"></span>
          <span class="pace-bar h-3"></span>
        </span>
        <span class="font-semibold">Pace</span>
        <span class="text-[var(--color-text-muted)] ml-2 hidden md:inline">·</span>
        <span class="text-[var(--color-text-muted)] text-xs hidden md:inline">
          made for macOS in California
        </span>
      </div>

      <div class="pace-footer-links text-xs">
        <a href="/download" class="inline-flex min-h-11 items-center hover:text-white transition-colors">Download</a>
        <a href="/pricing" class="inline-flex min-h-11 items-center hover:text-white transition-colors">Pricing</a>
        <a href="/compared" class="inline-flex min-h-11 items-center hover:text-white transition-colors">Compared</a>
        <a href="/faq" class="inline-flex min-h-11 items-center hover:text-white transition-colors">FAQ</a>
        <a href="/docs/" class="inline-flex min-h-11 items-center hover:text-white transition-colors">Docs</a>
        <a href="/changelog" class="inline-flex min-h-11 items-center hover:text-white transition-colors">Changelog</a>
        <a href="https://github.com/HeyPace/pace/issues" class="inline-flex min-h-11 items-center hover:text-white transition-colors">Roadmap</a>
        <a
          href="https://github.com/HeyPace/pace"
          aria-label="GitHub repository"
          title="GitHub repository"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center hover:text-white transition-colors"
        >
          <svg
            viewBox="0 0 16 16"
            width="20"
            height="20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
            ></path>
          </svg>
          <span class="sr-only">GitHub repository</span>
        </a>
        <a href="/privacy" class="inline-flex min-h-11 items-center hover:text-white transition-colors">Privacy</a>
        <a href="/terms" class="inline-flex min-h-11 items-center hover:text-white transition-colors">Terms</a>
        <a href="mailto:hi@sarthakagrawal.dev" class="inline-flex min-h-11 items-center hover:text-white transition-colors">Email</a>
        <span>© 2026</span>
      </div>
    </div>
</nav>

<style>
  .pace-footer-navigation {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    min-width: 0;
  }
  .pace-footer-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(8rem, 100%), 1fr));
    column-gap: 1.5rem;
    width: 100%;
    min-width: 0;
  }
  .pace-footer-links > span {
    padding-block: .8rem;
  }
</style>
