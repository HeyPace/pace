    <script is:inline>
      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const link = target.closest("a[href]");
        if (!(link instanceof HTMLAnchorElement)) return;

        const destination = new URL(link.href, window.location.href);
        let eventName;

        if (destination.origin === window.location.origin && destination.pathname === "/download") {
          eventName = "pace_download_cta_clicked";
        } else if (destination.origin === window.location.origin && destination.pathname === "/pricing") {
          eventName = "pace_pricing_cta_clicked";
        } else if (destination.hostname === "github.com" && destination.pathname === "/HeyPace/pace/issues") {
          eventName = "pace_roadmap_cta_clicked";
        }

        const tracker = window.appHealth;
        if (!eventName || !tracker) return;

        tracker.track(eventName);

        const modifiedClick =
          event instanceof MouseEvent &&
          (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey);
        const opensAnotherTab = link.target === "_blank";
        const staysOnThisDocument =
          destination.origin === window.location.origin &&
          destination.pathname === window.location.pathname &&
          destination.search === window.location.search;

        if (modifiedClick || opensAnotherTab || staysOnThisDocument) return;

        event.preventDefault();
        tracker.flush().finally(() => window.location.assign(link.href));
      });
    </script>
