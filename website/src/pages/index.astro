---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import ScrollProgress from "../components/ScrollProgress.astro";
import MouseSpotlight from "../components/MouseSpotlight.astro";
import CursorFollower from "../components/CursorFollower.astro";
import SpecMarquee from "../components/SpecMarquee.astro";
import PageEnhancements from "../components/PageEnhancements.astro";
import Hero from "../components/Hero.astro";
import OnDevice from "../components/OnDevice.astro";
import Features from "../components/Features.astro";
import Automation from "../components/Automation.astro";
import Reach from "../components/Reach.astro";
import MeetingNotes from "../components/MeetingNotes.astro";
import Trust from "../components/Trust.astro";
import Comparison from "../components/Comparison.astro";
import Pricing from "../components/Pricing.astro";
import SocialProof from "../components/SocialProof.astro";
import FAQ from "../components/FAQ.astro";
import LiveByteCounter from "../components/LiveByteCounter.astro";

const description = "Private on-device Mac voice agent: listen, read the screen, take actions. Local models by default, no subscription. Compare the field at /compared. One-time $29.";
---

<BaseLayout title="Pace — private Mac voice agent that sees your screen" description={description}>
  <Nav />
  <SpecMarquee />
  <main>
    <Hero />
    <OnDevice />
    <Features />
    <Automation />
    <Reach />
    <MeetingNotes />
    <Trust />
    <Comparison />
    <SocialProof />
    <section class="px-6 py-24 border-y border-[var(--color-border-subtle)]">
      <div class="max-w-5xl mx-auto">
        <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-text-muted)]">Field guides</p>
        <h2 class="pace-display text-3xl md:text-5xl text-white mt-5 max-w-2xl">Understand the <em>local stack</em>, not just the pitch.</h2>
        <div class="grid md:grid-cols-2 mt-12 border-t border-[var(--color-border-subtle)]">
          <a class="py-5 md:pr-6 border-b border-[var(--color-border-subtle)] text-white hover:text-[var(--color-accent)]" href="/on-device-ai-assistant-mac">On-device AI assistant for Mac →</a>
          <a class="py-5 md:pl-6 border-b md:border-l border-[var(--color-border-subtle)] text-white hover:text-[var(--color-accent)]" href="/screen-aware-ai-assistant-mac">Screen-aware Mac assistants →</a>
          <a class="py-5 md:pr-6 border-b border-[var(--color-border-subtle)] text-white hover:text-[var(--color-accent)]" href="/private-voice-assistant-mac">Private Mac voice assistants →</a>
          <a class="py-5 md:pl-6 border-b md:border-l border-[var(--color-border-subtle)] text-white hover:text-[var(--color-accent)]" href="/mac-ai-assistant-actions">Mac assistant actions →</a>
          <a class="py-5 md:pr-6 border-b border-[var(--color-border-subtle)] text-white hover:text-[var(--color-accent)]" href="/on-device-meeting-notes-mac">On-device meeting notes →</a>
        </div>
      </div>
    </section>
    <Pricing />
    <FAQ />
  </main>
  <LiveByteCounter />

  <!-- Keep enhancement scripts after the page content so parsing reaches
       the hero first and each initializer can see the complete document. -->
  <ScrollProgress />
  <MouseSpotlight />
  <CursorFollower />
  <PageEnhancements />
</BaseLayout>
