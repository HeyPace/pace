---
import { fragment } from "../config/source-fragments";
import Base from "@saas-maker/templates/Base.astro";
import { WorkbenchPage } from "@saas-maker/templates/workbench-page";
import { baseProps } from "@saas-maker/templates/page";
import { productContent } from "@saas-maker/templates/schema";
import commandCenter from "../assets/command-center-960.webp";
import heroItalicFont from "@saas-maker/ui/fonts/instrument-serif-latin-italic.woff2?url";
import bodyFont from "@saas-maker/ui/fonts/geist-latin-normal.woff2?url";
import json from "../content/home.json";
import ProductFooter from "../components/ProductFooter.astro";
import PageTracking from "../components/PageTracking.astro";
import CtaTracking from "../components/CtaTracking.astro";
import "../styles/home.css";
const content = productContent.parse(json);
if (content.template === "workbench" && content.hero.window) {
  content.hero.window.src = commandCenter.src;
  content.hero.window.width = commandCenter.width;
  content.hero.window.height = commandCenter.height;
}
---

<Base {...baseProps(content)} footerScript={false}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={commandCenter.src} type="image/webp" fetchpriority="high" />
    <link rel="preload" as="font" href={heroItalicFont} type="font/woff2" crossorigin />
    <link rel="preload" as="font" href={bodyFont} type="font/woff2" crossorigin />
    <meta name="ai-summary" content={content.page.description} />
    <meta name="application-name" content="HeyPace" />
    <link rel="alternate" type="text/markdown" href="https://heypace.app/index.md" />
  <!-- fleet-jsonld:start (generated by apply-agent-surfaces; edit registry, not this) -->
<script is:inline type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Person","@id":"https://sarthakagrawal.dev/#person","name":"Sarthak Agrawal","jobTitle":"AI Infrastructure & Product Engineer","url":"https://sarthakagrawal.dev","image":"https://avatars.githubusercontent.com/u/43884471?v=4","sameAs":["https://sarthakagrawal.dev","https://www.linkedin.com/in/sarthakagrawal927","https://github.com/sarthakagrawal927","https://x.com/sarthakcodes","https://huggingface.co/sarthakagrawal927"],"knowsAbout":["AI infrastructure","Local-first software","Post-training language models","AI code review","Cloudflare Workers","TypeScript","Rust"],"affiliation":{"@type":"Organization","@id":"https://sassmaker.com/#app","name":"SaaS Maker","url":"https://sassmaker.com"}},{"@type":"WebSite","@id":"https://heypace.app/#app","name":"HeyPace","alternateName":["Pace","heypace.app"],"url":"https://heypace.app","description":"On-device Mac voice agent that reads your screen and acts with local context.","publisher":{"@id":"https://sarthakagrawal.dev/#person"},"sameAs":["https://github.com/HeyPace/pace"]}]}</script>
<!-- fleet-jsonld:end -->
<script is:inline type="application/ld+json">{"@context":"https://schema.org","@type":"SoftwareApplication","@id":"https://heypace.app/#product","name":"HeyPace","alternateName":["Pace","Pace Mac assistant"],"url":"https://heypace.app","description":"On-device Mac voice assistant that reads your screen and acts with local context.","applicationCategory":"UtilitiesApplication","operatingSystem":"macOS","isAccessibleForFree":true,"publisher":{"@id":"https://sarthakagrawal.dev/#person"},"sameAs":["https://github.com/HeyPace/pace"]}</script>
    <PageTracking />
  </Fragment>
  <WorkbenchPage content={content}>
    <Fragment slot="footer">
      <Fragment set:html={fragment("home-guides")} />
      <ProductFooter />
    </Fragment>
  </WorkbenchPage>
  <CtaTracking />
</Base>
