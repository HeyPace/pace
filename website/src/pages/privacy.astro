---
import { fragment } from "../config/source-fragments";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const description =
  "Pace keeps app audio, screen context, and text on your Mac; the public website uses bounded analytics.";
---

<BaseLayout
  title="Privacy — Pace"
  description={description}
  pathname="/privacy"
>
  <Nav />
<Fragment set:html={fragment("privacy")} />

  <Footer slot="footer-navigation" />
</BaseLayout>
