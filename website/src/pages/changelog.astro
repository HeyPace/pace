---
import { fragment } from "../config/source-fragments";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

import { entries } from "../config/changelog-content";

---

<BaseLayout
  title="Changelog — Pace"
  description="Verified Pace product updates, written as concise user-visible outcomes."
  pathname="/changelog"
>
  <Nav />
  <main class="px-6 pb-24 pt-32 md:pt-40">
    <div class="mx-auto max-w-4xl">
<Fragment set:html={fragment("changelog-intro")} />
      <ol class="mt-20 border-t border-[var(--color-border-subtle)]">
        {
          entries.map((entry) => (
            <li class="grid gap-5 border-b border-[var(--color-border-subtle)] py-10 md:grid-cols-[9rem_1fr] md:gap-10">
              <time
                class="font-mono text-xs tracking-wider text-[var(--color-text-muted)]"
                datetime={entry.date}
              >
                {entry.date}
              </time>
              <article>
                <h2 class="pace-display text-2xl text-white md:text-3xl">
                  <em>{entry.title}</em>
                </h2>
                <ul class="mt-5 space-y-3 text-sm leading-6 text-[var(--color-text-secondary)] md:text-base">
                  {entry.outcomes.map((outcome) => (
                    <li class="flex gap-3">
                      <span class="mt-2 h-1 w-1 shrink-0 bg-[var(--color-accent)]" aria-hidden="true" />
                      <span>{outcome}</span>
                    </li>
                  ))}
                </ul>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </main>
  <Footer slot="footer-navigation" />
</BaseLayout>
