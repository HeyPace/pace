---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ScrollProgress from "../components/ScrollProgress.astro";
import MouseSpotlight from "../components/MouseSpotlight.astro";
import CursorFollower from "../components/CursorFollower.astro";
import PageEnhancements from "../components/PageEnhancements.astro";
import { paceCheckoutURL, paceCheckoutIsMailto, studioInterestURL } from "../config/commerce";

const description =
  "Pace pricing — a free Apple Foundation Models preview, a $29 one-time purchase, and a clearly marked planned Studio option.";

// Tier data sourced from PROJECT_STATUS.md "Pricing posture (landing)":
//   Try (free) / Pace ($29 one-time) / Studio ($5/mo Composio routing).
// Do NOT invent prices — every value below is anchored to that line.
const tiers = [
  {
    name: "Try",
    price: "Free",
    cadence: "",
    blurb:
      "Runs against Apple's Foundation Models tier on any Mac with Apple Intelligence. The full app — voice, screen reading, actions, meeting notes — at no cost. You'll know within a week if the bundled stack is worth $29.",
    cta: { label: "Download Pace", href: "/download" },
    features: [
      "Apple Foundation Models planner (in-process, zero install)",
      "Push-to-talk voice loop with on-device ASR + TTS",
      "Optional local VLM screen reading (LM Studio)",
      "Action executor — clicks, typing, app/URL opens, calendar, reminders",
      "Meeting notes (pinned local, on-device synthesis)",
      "Thread + episodic memory, screen-watch & app-usage journals",
      "Recipe library + teachable skills",
      "MCP stdio tool bridge (you host the servers)",
    ],
    limits: [
      "No bundled Pace-tuned local model — uses Apple FM or your own LM Studio",
      "Apple Intelligence and macOS 26 required for Apple Foundation Models",
    ],
  },
  {
    name: "Pace",
    price: "$29",
    cadence: "one-time",
    blurb:
      "The current bundled local model stack — Qwen3-4B planner, Qwen3-VL-4B vision, Qwen3 TTS, and Kokoro-82M sidecar — all in-process, with no LM Studio requirement.",
    cta: { label: paceCheckoutIsMailto ? "Email to buy Pace — $29" : "Buy Pace — $29", href: paceCheckoutURL },
    features: [
      "Everything in Try, plus:",
      "Bundled MLX planner (Qwen3-4B) — no external install",
      "Bundled MLX-VLM (Qwen3-VL-4B) for screen reading",
      "Bundled Qwen3 TTS + Kokoro-82M sidecar",
      "WhisperKit ASR scaffold (opt-in)",
      "Sparkle app-update support",
      "Purchase terms confirmed before payment",
    ],
    limits: [
      "Current 0.3.19 preview requires macOS 26, Apple Silicon, and 16 GB RAM minimum (32 GB for bf16)",
      "~8 GB one-time model download into HuggingFace cache",
    ],
  },
  {
    name: "Studio (planned)",
    price: "$5",
    cadence: "/month",
    blurb:
      "A proposed managed-routing convenience for people who do not want to configure Composio themselves. It is not available for purchase yet.",
    cta: { label: "Get Studio updates", href: studioInterestURL },
    features: [
      "Everything in Pace, plus:",
      "Planned managed Composio routing",
      "Planned connector setup and authentication",
      "Price target: $5/month when available",
    ],
    limits: [
      "Not live and not currently sold",
      "Today's Composio integration uses your own API key",
      "Off-device tool calls route through Composio when you enable it",
    ],
  },
];

// Product + Offer JSON-LD includes only options available today. Studio is
// deliberately excluded until the hosted service is actually available.
const siteOrigin = Astro.site ?? "https://heypace.app";
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "HeyPace",
  description:
    "On-device macOS voice agent that reads your screen and acts with local context. Try the current preview free or buy Pace for $29 once.",
  brand: { "@type": "Brand", name: "HeyPace" },
  url: new URL("/pricing", siteOrigin).toString(),
  offers: [
    {
      "@type": "Offer",
      name: "Try",
      price: "0.00",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
      description:
        "Free tier — runs against Apple Foundation Models. No cost, full app.",
      url: new URL("/download", siteOrigin).toString(),
    },
    {
      "@type": "Offer",
      name: "Pace",
      price: "29.00",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
      description:
        "One-time $29 current bundled local model stack (Qwen3-4B planner, VLM, and TTS), with manual terms confirmed before payment.",
      url: new URL("/pricing", siteOrigin).toString(),
    },
  ],
};
---

<BaseLayout title="Pricing — Pace" description={description} pathname="/pricing">
  <ScrollProgress />
  <MouseSpotlight />
  <CursorFollower />
  <PageEnhancements />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(productSchema)}
    slot="head"
  />

  <Nav />

  <main class="px-6 pt-32 md:pt-40 pb-24">
    <div class="max-w-5xl mx-auto">
      <!-- ── Hero ─────────────────────────────────────────────── -->
      <p class="text-sm uppercase tracking-widest text-[var(--color-text-muted)] font-mono mb-6">
        Pricing
      </p>

      <h1 class="pace-display text-4xl md:text-6xl text-white mb-10 max-w-3xl">
        Try it free. <em>Buy it once.</em> Studio comes later.
      </h1>

      <div class="pace-prose mb-20">
        <p>
          Pace is fully on-device — the inference costs nothing to run, so
          there's no per-turn bill to pass on. Pace is a $29 one-time purchase,
          currently handled through a manual email path when hosted checkout is
          not configured. The downloadable preview remains free.
        </p>
        <p>
          Try the whole app free first. If your Mac has Apple Intelligence,
          Pace runs against Apple's Foundation Models at no cost. Buy the $29
          purchase only after you've decided the bundled stack is worth it.
        </p>
      </div>

      <!-- ── Tier table ───────────────────────────────────────── -->
      <div class="grid md:grid-cols-3 gap-6 mb-20">
        {
          tiers.map((tier) => (
            <div class="pace-card p-8 flex flex-col">
              <div class="mb-6">
                <h2 class="pace-display text-2xl text-white mb-2">{tier.name}</h2>
                <div class="flex items-baseline gap-2">
                  <span class="pace-display text-4xl text-white">{tier.price}</span>
                  {tier.cadence && (
                    <span class="text-sm text-[var(--color-text-muted)]">{tier.cadence}</span>
                  )}
                </div>
              </div>

              <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-6">
                {tier.blurb}
              </p>

              <a
                href={tier.cta.href}
                class={tier.name === "Pace" ? "pace-cta-primary text-sm mb-6" : "pace-cta-secondary text-sm mb-6"}
              >
                {tier.cta.label}
                <span aria-hidden="true">→</span>
              </a>

              <div class="border-t border-[var(--color-border-subtle)] pt-5 mb-5">
                <p class="text-xs font-mono uppercase tracking-widest text-[var(--color-text-muted)] mb-3">
                  Includes
                </p>
                <ul class="space-y-2 text-sm text-[var(--color-text-secondary)]">
                  {tier.features.map((f) => (
                    <li class="flex gap-2">
                      <span class="text-[var(--color-positive)] shrink-0" aria-hidden="true">✓</span>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="border-t border-[var(--color-border-subtle)] pt-5 mt-auto">
                <p class="text-xs font-mono uppercase tracking-widest text-[var(--color-text-muted)] mb-3">
                  Limits
                </p>
                <ul class="space-y-2 text-sm text-[var(--color-text-muted)]">
                  {tier.limits.map((l) => (
                    <li class="flex gap-2">
                      <span class="text-[var(--color-text-muted)] shrink-0" aria-hidden="true">—</span>
                      <span>{l}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>

      <!-- ── Honesty notes ────────────────────────────────────── -->
      <section class="border-t border-[var(--color-border-subtle)] pt-16">
        <p class="text-sm uppercase tracking-widest text-[var(--color-text-muted)] font-mono mb-6">
          The fine print, stated plainly
        </p>

        <div class="pace-prose space-y-5">
          <p>
            <strong>Manual terms.</strong> The current release does not contain
            an in-app licence activation or deactivation system. Payment,
            delivery, support, included updates, and any refund terms are
            confirmed before payment.
          </p>
          <p>
            <strong>No roadmap pricing promise.</strong> Sparkle can deliver
            app updates, but the site does not promise a future model, delivery
            date, future list price, or perpetual upgrades.
          </p>
          <p>
            <strong>Studio is planned, not live.</strong> The current app can
            use Composio when you provide your own API key. A future $5/month
            Studio option would manage that routing; it is not sold today.
          </p>
          <p>
            <strong>Checkout.</strong>{" "}
            {paceCheckoutIsMailto ? (
              <>Pace is paid, but checkout is manual today. Email confirms the payment method and delivery before any money changes hands.</>
            ) : (
              <>The configured hosted checkout is live.</>
            )}
          </p>
        </div>

        <p class="pace-margin-note mt-12 max-w-md">
          Current preview: macOS 26, Apple Silicon, 16 GB RAM minimum.<br />
          32 GB if you want the bigger bf16 model loaded all the time —
          otherwise the 4-bit variant is one Settings toggle away.
        </p>
      </section>

      <!-- ── CTA ──────────────────────────────────────────────── -->
      <section class="text-center mt-32">
        <p class="pace-display text-2xl md:text-3xl text-white mb-8 max-w-xl mx-auto">
          Want to know what you're buying <em>before</em> you buy it?
        </p>
        <a href="/" class="pace-cta-secondary">
          See what Pace does
          <span aria-hidden="true">→</span>
        </a>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>
