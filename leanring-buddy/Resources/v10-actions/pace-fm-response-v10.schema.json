{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pace.local/schemas/pace-fm-response-v10.schema.json",
  "title": "Pace planner response v10",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "spokenText": {
      "type": "string"
    },
    "intent": {
      "type": "string",
      "enum": [
        "answer",
        "action",
        "dictate",
        "edit",
        "clarify",
        "refuse"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "args": {
          "type": "object",
          "additionalProperties": true
        },
        "calls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "args": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "name": {
                      "const": "coding_session"
                    }
                  },
                  "required": [
                    "name"
                  ]
                },
                "then": {
                  "required": [
                    "args"
                  ],
                  "properties": {
                    "args": {
                      "$ref": "#/$defs/codingSessionArguments"
                    }
                  }
                }
              }
            ]
          }
        },
        "answer": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "replacement": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "target": {
          "type": "string",
          "enum": [
            "focused",
            "selection"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "const": "coding_session"
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "required": [
              "args"
            ],
            "properties": {
              "args": {
                "$ref": "#/$defs/codingSessionArguments"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "spokenText",
    "intent"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "intent": {
            "const": "action"
          }
        }
      },
      "then": {
        "required": [
          "payload"
        ]
      }
    }
  ],
  "$defs": {
    "codingSessionArguments": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "start"
            },
            "directory": {
              "type": "string",
              "minLength": 1
            },
            "task": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "operation",
            "directory",
            "task"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "resume"
            },
            "sessionID": {
              "type": "string",
              "format": "uuid"
            },
            "task": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "operation",
            "sessionID",
            "task"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "status"
            },
            "sessionID": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "operation"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "cancel"
            },
            "sessionID": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "operation",
            "sessionID"
          ]
        }
      ]
    }
  }
}
