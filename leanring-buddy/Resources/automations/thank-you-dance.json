{
  "schemaVersion": 1,
  "identifier": "thank-you-dance",
  "name": "Thank You Dance",
  "description": "Present an adult anime woman for six seconds and greet and thank you in Japanese locally.",
  "category": "media",
  "invocationPhrases": [
    "show me the thank you dance",
    "play my thank you dance",
    "run my thank you dance",
    "show me the Japanese greeting"
  ],
  "source": "bundled",
  "executionMode": "deterministicLocal",
  "requiredPreferences": [],
  "steps": [
    {
      "toolCalls": [
        {
          "tool": "present_media",
          "arguments": {
            "assetID": "japanese-greeting-woman",
            "durationSeconds": 6
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "tool": "speak",
          "arguments": {
            "text": "こんにちは。会えてうれしいです。ありがとうございます。",
            "profile": "japanese_female"
          }
        }
      ]
    }
  ]
}
