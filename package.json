{
  "name": "pace-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "description": "Pace documentation site (Blume presentation layer). The committed Markdown under docs/ is the source of truth; Blume only renders and searches it.",
  "scripts": {
    "format:check": "node scripts/check-swift-format.mjs",
    "lint": "node scripts/check-swift-format.mjs",
    "typecheck": "bash scripts/test-pace.sh",
    "test": "bash scripts/test-pace.sh",
    "test:coverage": "bash scripts/test-pace.sh --coverage",
    "quality:unused": "node scripts/check-unused-code.mjs",
    "quality:duplication": "node scripts/check-duplication.mjs",
    "quality:dependencies": "node scripts/check-dependency-risk.mjs",
    "test:dependency-security": "node --test scripts/http-cache-security.test.mjs",
    "docs:dev": "blume dev",
    "docs:build": "blume build",
    "docs:preview": "blume preview",
    "docs:validate": "blume validate",
    "docs:check": "blume check",
    "docs:doctor": "blume doctor"
  },
  "devDependencies": {
    "astro": "7.3.5",
    "blume": "1.4.3",
    "jscpd": "5.0.14"
  },
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.18": "3.3.18",
      "sharp@<0.35.4": "0.35.4",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "svgo@>=4.0.0 <4.1.0": "4.1.0",
      "image-size@<2.0.3": "2.0.3",
      "undici@>=7.0.0 <8.0.0": "7.29.1",
      "undici@>=8.0.0 <9.0.0": "8.10.2",
      "brace-expansion@>=2.0.0 <3.0.0": "2.1.6",
      "brace-expansion@>=5.0.0 <6.0.0": "5.0.11",
      "devalue@>=5.0.0 <6.0.0": "5.9.3",
      "@astrojs/node@>=11.0.0 <12.0.0": "11.1.3",
      "http-cache-semantics": "4.3.0"
    },
    "patchedDependencies": {
      "http-cache-semantics@4.3.0": "patches/http-cache-semantics@4.3.0.patch"
    }
  }
}
